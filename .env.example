# The actual assessment duration: 15 minutes. Runtime rejects shorter delays.
PULL_DELAY_MS=900000
PORT=3000
MOCK_PORT=4100
DATA_DIR=./data/jobs
# The network destroys connections after 30 seconds; live sockets renew at 25.
# These two assessment limits are constants in src/timing.js.
# Optional: set a long random shared secret for the trusted local callback.
# CALLBACK_SECRET=
